        {
          "id": "41fe093f-3e5b-45e7-b15e-65e03dd62fcb",
          "name": "Create the custom report",
          "request": {
            "name": "Create the custom report",
            "description": {
              "content": "The endpoint allows scheduling a custom report of a specific type for a given time period. Depending on the report type, you can also narrow down the data using appropriate filters.\n\n<strong>Important:</strong> The reports you can generate depend on your pricing plan.\n\nMore information about using the endpoint, along with examples, can be found in the Case Study section of the [API documentation](http://apidocs.getresponse.com/v3/case-study/custom-reports-scheduling).",
              "type": "text/plain"
